    //create an interfac IDiscountable with method ApplyDiscount().
    //create a class Course with a constructer that accepts course name and price.
    //implement the inerface and calculate discounted price
    
    interface IDiscountable
    {
        public double ApplyDiscount(double DiscountRate);
    }

    public class Course : IDiscountable
    {
        public string course_name;
        public double price;
        public double DiscountRate
        {
            get
            {
                return DiscountRate;
            }
            set
            {

            }
        }

        
        public Course(string p_course_name, double p_price)
        {
            this.course_name = p_course_name;
            this.price = p_price;
        }

        public double ApplyDiscount(double DiscountRate)
        {
            this.price = this.price - (this.price * DiscountRate / 100);
            return this.price;
        }
    }

    //create an interface called IPayable with a method CalculatePayment()
    //Implement tis interface in FullTimeEmployee and PartTimeEmployee classes
    //Each class should have different payment rate fulltime 1x, parttime 0.8x

    interface IPayable
    {
        public double CalculatePayment(double payment);        
    }
    public class FullTimeEmployee : IPayable
    {
        public double CalculatePayment(double payment)
        {
            return payment; 
        }
    }
    public class PartTimeEmployee : IPayable
    {
        public double CalculatePayment(double payment)
        {
            return payment * 0.8;
        }
    }

