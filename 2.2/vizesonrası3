    //create a class called Manager inherits from employee
    //overrides CalculateBonus() so that the bonus is calculated as 
    //20% of the salary
    //ın the main method create manager object and call the necessary method

    public abstract class Employee
    {
        protected string name;
        protected double salary;

        public Employee(string name, double salary)
        {
            this.name = name;
            this.salary = salary;
        }

        public abstract double CalculateBounus();
     
    }

    class Manager : Employee
    {
        public Manager(string name, double salary) : base(name, salary) { }
        public override double CalculateBounus()
        {
            this.salary = salary * 20 / 100;
            return this.salary;
        }
    }

    //creat an abstract class calles payment that contains 
    //an abstract method called Pay(double amount)
    //create three derived classes calles CreditCardPayment, CashPayment, CryptoPayment
    //override pay method differently in each class
    //pay method of ccp class applies 5% extra bill
    //pay method of cashp class applies 5% discount
    //pay method of cryp class applies no discount
    //

    public abstract class Payment
    {
        public double amount;
        public abstract double Pay(double amount);
    }

    public class CreditCardPayment : Payment
    {
        public override double Pay(double amount)
        {
            this.amount = amount + (amount * 5 / 100);
            return this.amount;
        }
    }

    public class CashPayment : Payment
    {
        public override double Pay(double amount)
        {
            this.amount = amount - (amount * 5 / 100);
            return this.amount;
        }
    }

    public class CryptoPayment : Payment
    {
        public override double Pay(double amount)
        {
            this.amount = amount;
            return this.amount;
        }
    }

